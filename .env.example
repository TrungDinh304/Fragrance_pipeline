# Copy sang .env rồi sửa. Docker Compose tự đọc .env ở thư mục này.
#
#     cp .env.example .env

# Múi giờ của container. Không đặt thì là UTC, và RUN_AT=02:30 sẽ thành 09:30
# sáng theo giờ VN — đúng giờ máy đang được dùng, tức là ngược hẳn ý định.
TZ=Asia/Ho_Chi_Minh

# Giờ chạy lượt crawl mỗi ngày (HH:MM, theo TZ ở trên).
RUN_AT=02:30

# 1 = chạy luôn một lượt khi container vừa bật, không chờ tới RUN_AT.
# Để 1 lần đầu cho chắc là mọi thứ hoạt động, rồi đổi lại 0.
RUN_ON_START=0

# 1 = dùng browser thật (--render). Tắt thì crawl nhanh hơn nhưng THIẾU
# when_to_wear, độ lưu hương và độ toả hương.
RENDER=1

# Để trống = dùng mặc định trong perfume_intel/config.py
# (DAILY_BUDGET=150 request, DAILY_BRANDS=2 hãng).
BUDGET=
BRANDS=

# Nghỉ giữa 2 request, hai số cách nhau bởi dấu cách. Trống = 5-10 giây.
DELAY=

# --- Data lake (MinIO / S3) --------------------------------------------------
# LAKE=s3 thì MinIO là NƠI LƯU CHÍNH THỨC của bronze và silver; data/raw/ tụt
# xuống thành spool ghi trước + cache đọc. LAKE=off thì data/raw/ là bản gốc.
# docker-compose.yml mặc định đã là s3 nên dòng này chỉ cần khi chạy ngoài Docker.
LAKE=s3

# Khoá MinIO. ĐỔI TRƯỚC KHI MỞ CỔNG 9000/9001 RA NGOÀI MÁY — mặc định dưới đây
# chỉ dùng được cho máy cá nhân.
MINIO_ROOT_USER=perfume
MINIO_ROOT_PASSWORD=perfume-dev-only

# Cổng ra host. Đổi nếu máy đã có gì chiếm 9000/9001.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Chỉ cần khi chạy CLI NGOÀI Docker (trong Docker thì tên service là `minio`).
#     S3_ENDPOINT=http://localhost:9000
#     S3_ACCESS_KEY=perfume
#     S3_SECRET_KEY=perfume-dev-only

# Hai bucket riêng: bronze bật versioning và không bao giờ hết hạn (crawl lại mất
# nhiều ngày), silver dựng lại trong vài giây nên không cần.
BRONZE_BUCKET=bronze
SILVER_BUCKET=silver

# CẨN THẬN MỘT CHỖ: biến `S3_ENDPOINT` chỉ dành cho CLI chạy NGOÀI Docker. Trong
# container, endpoint luôn là http://minio:9000 và KHÔNG lấy theo S3_ENDPOINT —
# vì `localhost:9000` ở host trỏ vào MinIO, còn trong container nó trỏ vào chính
# container đó. Muốn compose nói với một S3 khác thì đặt COMPOSE_S3_ENDPOINT.
# COMPOSE_S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com

# --- Kho vector (Postgres + pgvector) ----------------------------------------
# Kho PHỤC VỤ, không phải nguồn sự thật: nó chỉ nạp từ
# data/silver/perfume_embeddings.parquet. Xoá đi nạp lại bằng `cli vectordb load`.
PG_USER=perfume
PG_PASSWORD=perfume-dev-only
PG_DB=perfume
# 5433 chứ không phải 5432: máy này đã có Postgres khác chiếm 5432.
PG_PORT=5433

# Model embedding. ĐỔI LÀ PHẢI SINH LẠI TOÀN BỘ (`cli embed` rồi `cli vectordb
# load`) — vector của hai model vẫn cộng trừ được với nhau nhưng kết quả vô nghĩa,
# và không có cách nào phát hiện từ con số.
# 384 chiều, 0,22 GB, đo được 5/5 trên câu hỏi tiếng Việt.
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Chatbot: gọi AI qua 9router ---------------------------------------------
# 9router chạy trên MÁY HOST (mặc định http://localhost:20128/v1), gộp 40+ nhà
# cung cấp sau một endpoint kiểu OpenAI.
#
# BẮT BUỘC CÓ KHOÁ: /v1/models không đòi khoá nhưng /v1/chat/completions thì có,
# nên endpoint trả 200 KHÔNG có nghĩa là đã đủ cấu hình. Lấy khoá trong dashboard
# 9router rồi dán vào đây. Thiếu khoá thì trang chatbot vẫn chạy nhưng câu trả lời
# là bản ghép sẵn bằng Python, và ý định tách bằng từ khoá thay vì bằng model.
LLM_API_KEY=
LLM_MODEL=kr/claude-haiku-4.5

# Chỉ cần khi chạy CLI NGOÀI Docker:
#     LLM_BASE_URL=http://localhost:20128/v1
# Trong container thì endpoint là http://host.docker.internal:20128/v1 và KHÔNG
# lấy theo LLM_BASE_URL — `localhost` trong container trỏ vào chính nó. Muốn đổi
# thì dùng COMPOSE_LLM_BASE_URL.

# Cổng của API + trang test chatbot.
API_PORT=8000
